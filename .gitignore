# Byte-compiled / cache
__pycache__/
*.py[cod]
*.pyc

# Virtual environments
venv/
.venv/
env/

# Environment variables / secrets
.env
*.key
*.pem

# Data (too large for git, fetch via scripts instead)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Model artifacts
*.h5
*.pkl
*.joblib
saved_models/

# MLflow
mlruns/
mlartifacts/

# Jupyter
.ipynb_checkpoints/

# OS / editor
.DS_Store
.idea/
.vscode/

# Logs
*.log

# Test coverage
.coverage
htmlcov/
.pytest_cache/
